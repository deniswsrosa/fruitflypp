# Copy this file to .env and supply your Couchbase query-service credentials.
# The cluster must have the travel-sample bucket installed.
CB_QUERY_URL=http://127.0.0.1:8093/query/service
CB_USER=your-query-user
CB_PASS=your-query-password
CB_TLS_VERIFY=true
PORT=8788
HOST=127.0.0.1
# BRAIN_PYTHON=/path/to/python
